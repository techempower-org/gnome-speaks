[Unit]
Description=GNOME Speaks - Shared Speech Service (TTS/STT via Azure)
Documentation=https://github.com/jphein/gnome-speaks
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=dbus
BusName=org.gnome.Speaks
ExecStart=@SERVICE_EXEC@
# Release blocker, not polish: a crash between SetGlobalEngine(ours) and
# SetGlobalEngine(prior) leaves NO global engine and the daemon does not
# auto-revert (measured, GNOME 50.1). This runs on every stop, including
# restart and OOM-kill. '-' so a failed restore never blocks the stop.
ExecStopPost=-@SERVICE_EXEC@ --restore-ime
Restart=always
RestartSec=2
TimeoutStopSec=10
PassEnvironment=DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR PULSE_SERVER
Environment=SPEECH_ENGINE_PATH=%h/Projects/speech-to-cli
Environment=CLOUD_CHAT_PATH=%h/Projects/cloud-chat-assistant
Environment=GNOME_SPEAKS_INACTIVITY_TIMEOUT_SEC=0

[Install]
WantedBy=graphical-session.target
